# Supabase: Project Settings -> API (hosted), or `npx supabase status` (local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The site's public address, used in email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications (matches, messages, payments, support) through Resend.
# Free: 3,000 emails a month at https://resend.com. Leave unset and emails are
# printed in the terminal instead of sent.
# RESEND_API_KEY=
# EMAIL_FROM="Daliapply <hello@daliapply.com>"
SALES_EMAIL=sales@daliapply.com
SUPPORT_EMAIL=support@daliapply.com

# Optional. Leave unset to use the free built-in resume reader and search.
# Set it (https://console.anthropic.com) to use Claude instead, billed per use.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
